{
    "name": "jira-cli",
    "version": "1.0.0",
    "description": "CLI tool to interact with Jira API v3",
    "main": "index.js",
    "scripts": {
        "start": "node index.js",
        "build:win": "pkg . --targets node18-win-x64 --output dist/jira-cli.exe --no-bytecode --public",
        "build:linux": "pkg . --targets node18-linux-x64 --output dist/jira-cli --no-bytecode --public",
        "build:mac": "pkg . --targets node18-macos-x64 --output dist/jira-cli --no-bytecode --public",
        "build:all": "pkg . --targets node18-win-x64,node18-linux-x64,node18-macos-x64 --output dist/jira-cli- --no-bytecode --public",
        "package": "npm run build:win && cd dist && zip -r jira-cli-windows.zip jira-cli.exe",
        "test:build": "npm run build:win && echo 'Build complete. Test with: ./dist/jira-cli.exe --help'"
    },
    "dependencies": {
        "axios": "^1.6.0",
        "cli-table3": "^0.6.5",
        "commander": "^11.1.0",
        "nodemailer": "^7.0.11"
    },
    "devDependencies": {
        "pkg": "^5.8.1"
    },
    "bin": {
        "jira-cli": "./index.js"
    },
    "pkg": {
        "scripts": [
            "index.js",
            "src/**/*.js"
        ],
        "assets": [
            "README.md",
            "node_modules/axios/dist/**/*",
            "node_modules/cli-table3/**/*",
            "node_modules/commander/**/*",
            "node_modules/nodemailer/**/*"
        ]
    }
}
